# Chaves Públicas (Frontend Vite)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-aqui

# Compatibilidade Universal / Next.js
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-aqui

# Chaves Globais / Backend / Server Scripts
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-aqui
SUPABASE_SECRET_KEY=sua-chave-secreta-aqui
